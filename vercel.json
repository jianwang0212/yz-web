{
  "version": 2,
  "rewrites": [
    {
      "source": "/year-review",
      "destination": "/year-review.html"
    },
    {
      "source": "/financial-dashboard",
      "destination": "/financial-dashboard.html"
    },
    {
      "source": "/projects/interval-quiz.js",
      "destination": "/papers/interval-quiz.js"
    },
    {
      "source": "/projects/degree-quiz.js",
      "destination": "/papers/degree-quiz.js"
    },
    {
      "source": "/projects/chord-quiz.js",
      "destination": "/papers/chord-quiz.js"
    },
    {
      "source": "/projects/chord-trainer-assets/(.*)",
      "destination": "/papers/chord-trainer-assets/$1"
    },
    {
      "source": "/projects/left-hand-voicing-trainer-assets/(.*)",
      "destination": "/papers/left-hand-voicing-trainer-assets/$1"
    },
    {
      "source": "/projects/vipassana",
      "destination": "/papers/vipassana.html"
    },
    {
      "source": "/projects/vipassana.html",
      "destination": "/papers/vipassana.html"
    },
    {
      "source": "/projects/apartment-sublet",
      "destination": "/papers/apartment-sublet.html"
    },
    {
      "source": "/projects/apartment-sublet.html",
      "destination": "/papers/apartment-sublet.html"
    },
    {
      "source": "/projects/interval-quiz",
      "destination": "/papers/interval-quiz.html"
    },
    {
      "source": "/projects/interval-quiz.html",
      "destination": "/papers/interval-quiz.html"
    },
    {
      "source": "/projects/degree-quiz",
      "destination": "/papers/degree-quiz.html"
    },
    {
      "source": "/projects/degree-quiz.html",
      "destination": "/papers/degree-quiz.html"
    },
    {
      "source": "/projects/chord-quiz",
      "destination": "/papers/chord-quiz.html"
    },
    {
      "source": "/projects/chord-quiz.html",
      "destination": "/papers/chord-quiz.html"
    },
    {
      "source": "/projects/chord-trainer",
      "destination": "/papers/chord-trainer.html"
    },
    {
      "source": "/projects/chord-trainer.html",
      "destination": "/papers/chord-trainer.html"
    },
    {
      "source": "/projects/left-hand-voicing-trainer",
      "destination": "/papers/left-hand-voicing-trainer.html"
    },
    {
      "source": "/projects/left-hand-voicing-trainer.html",
      "destination": "/papers/left-hand-voicing-trainer.html"
    }
  ],
  "redirects": [
    {
      "source": "/papers/vipassana.html",
      "destination": "/projects/vipassana",
      "permanent": true
    },
    {
      "source": "/papers/apartment-sublet.html",
      "destination": "/projects/apartment-sublet",
      "permanent": true
    },
    {
      "source": "/papers/interval-quiz",
      "destination": "/projects/interval-quiz",
      "permanent": true
    },
    {
      "source": "/papers/interval-quiz.html",
      "destination": "/projects/interval-quiz",
      "permanent": true
    },
    {
      "source": "/papers/degree-quiz.html",
      "destination": "/projects/degree-quiz",
      "permanent": true
    },
    {
      "source": "/papers/chord-quiz.html",
      "destination": "/projects/chord-quiz",
      "permanent": true
    },
    {
      "source": "/papers/chord-trainer",
      "destination": "/projects/chord-trainer",
      "permanent": true
    },
    {
      "source": "/papers/chord-trainer.html",
      "destination": "/projects/chord-trainer",
      "permanent": true
    },
    {
      "source": "/papers/left-hand-voicing-trainer",
      "destination": "/projects/left-hand-voicing-trainer",
      "permanent": true
    },
    {
      "source": "/papers/left-hand-voicing-trainer.html",
      "destination": "/projects/left-hand-voicing-trainer",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "x-forwarded-proto",
          "value": "http"
        }
      ],
      "destination": "https://thisisyz.com/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    }
  ]
}
